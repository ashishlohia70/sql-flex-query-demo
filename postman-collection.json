    {
      "name": "Orders",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"selectColumns\": [\n    \"orderId\",\n    \"orderDate\",\n    \"orderStatus\",\n    \"totalAmount\",\n    \"customerId\",\n    \"customerName\",\n    \"customerEmail\"\n  ],\n  \"whereParams\": [\n    {\"key\": \"o.status\", \"operation\": \"EQ\", \"value\": \"SHIPPED\"}\n  ],\n  \"textSearchParams\": [],\n  \"sortBy\": [{\"key\": \"o.order_date\", \"direction\": \"DESC\"}],\n  \"page\": 1,\n  \"size\": 10,\n  \"columnMapper\": {\n    \"orderId\": \"o.id\",\n    \"orderDate\": \"o.order_date\",\n    \"orderStatus\": \"o.status\",\n    \"totalAmount\": \"o.total_amount\",\n    \"customerId\": \"c.id\",\n    \"customerName\": \"c.name\",\n    \"customerEmail\": \"c.email\"\n  }\n}"
            },
